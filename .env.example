# TikTok Developer credentials (server-side only)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
APP_URL=

# Required production security keys. Generate unique values; never commit them.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# live calls TikTok. demo uses clearly labelled local sample data and never calls TikTok.
TIKTOK_MODE=live

# Optional deployment settings
PUBLISHER_DB_PATH=output/build/pipeline/publisher/publisher.db
PUBLISHER_UPLOAD_DIR=output/build/pipeline/publisher/uploads
VIDGEN_HANDOFF_SECRET=
