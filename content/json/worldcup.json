  "editorial_notes": {
    "target_duration_seconds": 62.5,
    "tone": "giải thích công nghệ bằng hài tình huống — truy tìm 'vài giây bị mất' như phim trinh thám",
    "retention_pattern": "hook → phóng đại → mở loop 'vài giây trốn đi đâu' → thủ phạm 1 (máy nén) → thủ phạm 2 (đường đi) → twist: thủ phạm cuối là chính chiếc TV + trade-off mờ/chậm → payoff",
    "technical_thesis": "Độ trễ cộng dồn từ capture/encode, distribution/network, và lớn nhất là player buffer; chênh lệch giữa hai nhà do nguồn phát, ứng dụng, mạng, thiết bị và cấu hình bộ đệm. TV tối ưu 'không đứng hình', không tối ưu 'nhanh nhất'."
  }
